    <SolidColorBrush x:Key="Brush.Border" Color="#3A3A3A" />
    <SolidColorBrush x:Key="Brush.Text" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="#C8C8C8" />
