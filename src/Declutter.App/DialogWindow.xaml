<Window x:Class="Declutter.App.DialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="480" SizeToContent="Height" MaxHeight="640" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Window}" Foreground="{DynamicResource Brush.Text}"
        TextElement.FontFamily="{DynamicResource Font.Body}" TextElement.FontSize="13">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Margin="24,20,24,20">
            <TextBlock x:Name="TitleText" Style="{StaticResource SectionTitle}" FontSize="20" TextWrapping="Wrap" />
            <ScrollViewer MaxHeight="420" VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                <TextBlock x:Name="MessageText" TextWrapping="Wrap" Foreground="{DynamicResource Brush.TextSecondary}" LineHeight="20" />
            </ScrollViewer>
        </StackPanel>
        <Border Grid.Row="1" Background="{DynamicResource Brush.Nav}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0" Padding="24,16">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="PrimaryButton" Style="{StaticResource AccentButton}" MinWidth="110" IsDefault="True" Click="OnPrimary" />
                <Button x:Name="SecondaryButton" Content="Cancel" MinWidth="110" Margin="8,0,0,0" IsCancel="True" Click="OnSecondary" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
