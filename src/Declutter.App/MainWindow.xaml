<Window x:Class="Declutter.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Declutter.App.ViewModels"
        xmlns:views="clr-namespace:Declutter.App.Views"
        Title="Declutter" Width="1200" Height="800" MinWidth="960" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.Window}"
        TextElement.Foreground="{DynamicResource Brush.Text}"
        TextElement.FontFamily="{DynamicResource Font.Body}"
        TextElement.FontSize="13"
        UseLayoutRounding="True">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:HomeViewModel}"><views:HomeView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SecurityViewModel}"><views:SecurityView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:JunkViewModel}"><views:JunkView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:StartupViewModel}"><views:StartupView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:FilesViewModel}"><views:FilesView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:AppsViewModel}"><views:AppsView /></DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="248" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Navigation pane -->
        <Border Background="{DynamicResource Brush.Nav}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,1,0">
            <DockPanel Margin="12,16,12,16">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,4,0,20">
                    <Image Source="Assets/Declutter.png" Width="28" Height="28" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="Declutter" FontFamily="{DynamicResource Font.Display}" FontSize="20" FontWeight="SemiBold"
                               VerticalAlignment="Center" Margin="10,0,0,0" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom">
                    <Border Style="{StaticResource Card}" Padding="14,12">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock Text="&#xEDA2;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0" />
                                <TextBlock Text="{Binding DriveName}" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </DockPanel>
                            <ProgressBar Value="{Binding DriveUsedFraction, Mode=OneWay}" Maximum="1" Height="6" Margin="0,10,0,6">
                                <ProgressBar.Style>
                                    <Style TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DriveIsLow}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ProgressBar.Style>
                            </ProgressBar>
                            <TextBlock Text="{Binding DriveText}" Style="{StaticResource Caption}" />
                            <TextBlock Text="{Binding Stats.Text}" Style="{StaticResource Caption}" Margin="0,4,0,0"
                                       Foreground="{DynamicResource Tone.Good.Foreground}"
                                       Visibility="{Binding Stats.HasFreed, Converter={StaticResource Visible}}" />
                        </StackPanel>
                    </Border>

                    <Button Margin="0,10,0,0" HorizontalAlignment="Stretch" Command="{Binding RestartAsAdminCommand}"
                            Visibility="{Binding IsElevated, Converter={StaticResource Collapsed}}"
                            ToolTip="Some cleanups need administrator rights. Windows will ask for permission.">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xEA18;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0" />
                            <TextBlock Text="Restart as administrator" />
                        </StackPanel>
                    </Button>
                    <StackPanel Orientation="Horizontal" Margin="4,10,0,0" Visibility="{Binding IsElevated, Converter={StaticResource Visible}}">
                        <TextBlock Text="&#xEA18;" Style="{StaticResource Icon}" FontSize="12" Foreground="{DynamicResource Brush.TextTertiary}" Margin="0,0,6,0" />
                        <TextBlock Text="Running as administrator" Style="{StaticResource Caption}" />
                    </StackPanel>

                    <DockPanel Margin="4,10,0,0">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding Version}" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                        <Button Content="Activity log" Style="{StaticResource LinkButton}" Command="{Binding OpenLogCommand}" FontSize="12"
                                HorizontalAlignment="Left" ToolTip="Everything Declutter changes is written to a log file." />
                    </DockPanel>
                </StackPanel>

                <ListBox Style="{StaticResource NavList}" ItemsSource="{Binding Pages}" SelectedItem="{Binding CurrentPage}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Glyph}" Style="{StaticResource Icon}" Width="20" />
                                <TextBlock Text="{Binding Title}" FontSize="14" Margin="12,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Current page -->
        <ContentControl Grid.Column="1" Content="{Binding CurrentPage}" Focusable="False" />
    </Grid>
</Window>
