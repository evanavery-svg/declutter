<UserControl x:Class="Declutter.App.Views.AppUpdatesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="36,32,36,24">
            <DockPanel>
                <Button DockPanel.Dock="Right" Command="{Binding RefreshCommand}" VerticalAlignment="Top">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72C;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0" />
                        <TextBlock Text="Check again" />
                    </StackPanel>
                </Button>
                <StackPanel>
                    <TextBlock Text="App updates" Style="{StaticResource PageTitle}" />
                    <TextBlock Style="{StaticResource PageSubtitle}"
                               Text="Old apps are the most common way in for malware. This lists apps with newer versions, using Windows' own package manager (winget), and updates the ones you pick." />
                </StackPanel>
            </DockPanel>

            <ProgressBar IsIndeterminate="{Binding IsBusy}" Margin="0,16,0,0" Visibility="{Binding IsBusy, Converter={StaticResource Visible}}" />
            <TextBlock Text="{Binding Status}" Style="{StaticResource Caption}" Margin="0,6,0,0" Visibility="{Binding Status, Converter={StaticResource Visible}}" />

            <Border Style="{StaticResource Card}" Margin="0,16,0,0" BorderThickness="0" Background="{DynamicResource Tone.Caution.Background}"
                    Visibility="{Binding WingetMissing, Converter={StaticResource Visible}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Get App Installer" Command="{Binding GetWingetCommand}" VerticalAlignment="Center" />
                    <TextBlock TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{DynamicResource Tone.Caution.Foreground}" Margin="0,0,12,0"
                               Text="winget comes with the free App Installer from the Microsoft Store. Install or update it, then click Check again." />
                </DockPanel>
            </Border>

            <DockPanel Margin="0,16,0,10" Visibility="{Binding HasRun, Converter={StaticResource Visible}}">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Update selected" Command="{Binding UpdateSelectedCommand}" Margin="0,0,8,0" />
                    <Button Content="Update all" Style="{StaticResource AccentButton}" Command="{Binding UpdateAllCommand}" />
                </StackPanel>
                <TextBlock Text="{Binding Summary}" Style="{StaticResource Body}" VerticalAlignment="Center" Margin="0,0,16,0" />
            </DockPanel>

            <ItemsControl ItemsSource="{Binding Rows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,6" Padding="16,12">
                            <DockPanel>
                                <CheckBox DockPanel.Dock="Left" IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,14,0"
                                          IsEnabled="{Binding CanSelect}"
                                          AutomationProperties.Name="{Binding Name, StringFormat=Select {0}}" />
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Versions}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="12,0,0,0" />
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource ItemTitle}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Source}" Style="{StaticResource Caption}" />
                                    <TextBlock Text="{Binding State}" Style="{StaticResource Caption}" Visibility="{Binding State, Converter={StaticResource Visible}}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
