<UserControl x:Class="Declutter.App.Views.HealthView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- One drive or battery: name, verdict badge, summary and the reasons behind it. -->
        <DataTemplate x:Key="HealthCard">
            <Border Style="{StaticResource Card}" Margin="0,0,0,10" Padding="20,16">
                <StackPanel>
                    <DockPanel>
                        <Border DockPanel.Dock="Right" Style="{StaticResource Badge}" Margin="12,0,0,0" VerticalAlignment="Top"
                                Background="{Binding GradeTone, Converter={StaticResource ToneBackground}}">
                            <TextBlock Text="{Binding GradeLabel}" FontSize="12" FontWeight="SemiBold" Foreground="{Binding GradeTone, Converter={StaticResource ToneForeground}}" />
                        </Border>
                        <StackPanel>
                            <TextBlock Text="{Binding Name}" Style="{StaticResource ItemTitle}" />
                            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Caption}" Visibility="{Binding Subtitle, Converter={StaticResource Visible}}" />
                        </StackPanel>
                    </DockPanel>

                    <Grid Margin="0,12,0,0" Visibility="{Binding HasPercent, Converter={StaticResource Visible}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding PercentText}" FontFamily="{DynamicResource Font.Display}" FontSize="28" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <ProgressBar Grid.Column="1" Value="{Binding Fraction, Mode=OneWay}" Maximum="1" Height="8" Margin="16,0,0,0" VerticalAlignment="Center" />
                    </Grid>

                    <TextBlock Text="{Binding Summary}" FontSize="15" FontWeight="SemiBold" Margin="0,10,0,0" TextWrapping="Wrap" />
                    <ItemsControl ItemsSource="{Binding Notes}" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,4">
                                    <TextBlock Text="{Binding Glyph}" Style="{StaticResource Icon}" FontSize="13" VerticalAlignment="Top" Margin="0,2,10,0"
                                               Foreground="{Binding Tone, Converter={StaticResource ToneForeground}}" />
                                    <TextBlock Text="{Binding Text}" Style="{StaticResource Body}" />
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="36,32,36,24">
            <DockPanel>
                <Button DockPanel.Dock="Right" Command="{Binding RefreshCommand}" VerticalAlignment="Top">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72C;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0" />
                        <TextBlock Text="Check again" />
                    </StackPanel>
                </Button>
                <StackPanel>
                    <TextBlock Text="Drive &amp; battery health" Style="{StaticResource PageTitle}" />
                    <TextBlock Style="{StaticResource PageSubtitle}"
                               Text="How your drives and battery are holding up, from Windows' own health data. Nothing is changed." />
                </StackPanel>
            </DockPanel>

            <ProgressBar IsIndeterminate="{Binding IsBusy}" Margin="0,16,0,0" Visibility="{Binding IsBusy, Converter={StaticResource Visible}}" />
            <TextBlock Text="{Binding Status}" Style="{StaticResource Caption}" Margin="0,6,0,0" Visibility="{Binding Status, Converter={StaticResource Visible}}" />

            <Border Style="{StaticResource Card}" Margin="0,16,0,0" BorderThickness="0" Background="{DynamicResource Tone.Caution.Background}">
                <Border.Visibility>
                    <MultiBinding Converter="{StaticResource AllTrue}">
                        <Binding Path="CountersNeedAdmin" />
                        <Binding Path="HasRun" />
                    </MultiBinding>
                </Border.Visibility>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Restart as administrator" VerticalAlignment="Center"
                            Command="{Binding DataContext.RestartAsAdminCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                    <TextBlock TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{DynamicResource Tone.Caution.Foreground}" Margin="0,0,12,0"
                               Text="Wear, temperature and error counts need administrator rights. Restart as administrator to see them." />
                </DockPanel>
            </Border>

            <TextBlock Text="Drives" Style="{StaticResource SectionTitle}" Margin="0,24,0,10" Visibility="{Binding HasRun, Converter={StaticResource Visible}}" />
            <TextBlock Text="Windows didn't report any drives." Style="{StaticResource Body}" Margin="0,0,0,10">
                <TextBlock.Visibility>
                    <MultiBinding Converter="{StaticResource AllTrue}">
                        <Binding Path="HasRun" />
                        <Binding Path="Disks.Count" Converter="{StaticResource IsZero}" />
                    </MultiBinding>
                </TextBlock.Visibility>
            </TextBlock>
            <ItemsControl ItemsSource="{Binding Disks}" ItemTemplate="{StaticResource HealthCard}" />

            <DockPanel Margin="0,16,0,10" Visibility="{Binding HasRun, Converter={StaticResource Visible}}">
                <Button DockPanel.Dock="Right" Content="Open full battery report" Command="{Binding BatteryReportCommand}"
                        Visibility="{Binding HasBattery, Converter={StaticResource Visible}}" VerticalAlignment="Center" />
                <StackPanel>
                    <TextBlock Text="Battery" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="{Binding BatteryMessage}" Style="{StaticResource Body}" Margin="0,4,0,0" Visibility="{Binding BatteryMessage, Converter={StaticResource Visible}}" />
                </StackPanel>
            </DockPanel>
            <ItemsControl ItemsSource="{Binding Batteries}" ItemTemplate="{StaticResource HealthCard}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
