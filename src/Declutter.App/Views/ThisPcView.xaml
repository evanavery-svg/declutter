<UserControl x:Class="Declutter.App.Views.ThisPcView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="36,32,36,24">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button Content="Copy details" Command="{Binding CopyCommand}" Margin="0,0,8,0" />
                    <Button Command="{Binding RefreshCommand}" AutomationProperties.Name="Refresh">
                        <TextBlock Text="&#xE72C;" Style="{StaticResource Icon}" FontSize="14" />
                    </Button>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="{Binding Heading}" Style="{StaticResource PageTitle}" TextWrapping="Wrap" />
                    <TextBlock Style="{StaticResource PageSubtitle}" Text="What's inside your PC, in plain terms." />
                </StackPanel>
            </DockPanel>

            <ProgressBar IsIndeterminate="{Binding IsBusy}" Margin="0,16,0,0" Visibility="{Binding IsBusy, Converter={StaticResource Visible}}" />
            <TextBlock Text="{Binding Status}" Style="{StaticResource Caption}" Margin="0,6,0,0" Visibility="{Binding Status, Converter={StaticResource Visible}}" />

            <Border Style="{StaticResource Card}" Margin="0,16,0,0" BorderThickness="0" Background="{DynamicResource Tone.Caution.Background}"
                    Visibility="{Binding RestartTip, Converter={StaticResource Visible}}">
                <DockPanel>
                    <TextBlock Text="&#xE777;" Style="{StaticResource Icon}" Foreground="{DynamicResource Tone.Caution.Foreground}" Margin="0,0,12,0" VerticalAlignment="Top" />
                    <TextBlock Text="{Binding RestartTip}" TextWrapping="Wrap" Foreground="{DynamicResource Tone.Caution.Foreground}" />
                </DockPanel>
            </Border>

            <!-- Device & warranty -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0" Padding="20,16" Visibility="{Binding Serial, Converter={StaticResource Visible}}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="Copy serial number" Command="{Binding CopySerialCommand}" Margin="0,0,8,0" />
                        <Button Content="Check warranty" Command="{Binding WarrantyCommand}" Visibility="{Binding HasWarrantyPage, Converter={StaticResource Visible}}" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Serial number" Style="{StaticResource Caption}" />
                        <TextBlock Text="{Binding Serial}" FontSize="16" FontWeight="SemiBold" Margin="0,2,0,0" />
                        <TextBlock Text="Support and warranty checks ask for this." Style="{StaticResource Body}" Margin="0,4,0,0" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Specs -->
            <Border Style="{StaticResource Card}" Margin="0,12,0,0" Padding="20,8">
                <ItemsControl ItemsSource="{Binding Rows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="210" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Label}" Style="{StaticResource Body}" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Value}" FontSize="14" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Hint}" Style="{StaticResource Caption}" Visibility="{Binding Hint, Converter={StaticResource Visible}}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <!-- Report -->
            <TextBlock Text="Share a report" Style="{StaticResource SectionTitle}" Margin="0,24,0,10" />
            <Border Style="{StaticResource Card}" Padding="20,16">
                <StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Content="Create report" Command="{Binding ReportCommand}" VerticalAlignment="Center" Margin="16,0,0,0" />
                        <TextBlock Style="{StaticResource Body}" VerticalAlignment="Center"
                                   Text="One page with everything Declutter checks: specs, storage, drive and battery health, security, startup apps and installed apps. Handy to send to someone helping you. Your user name and personal folder paths are left out." />
                    </DockPanel>
                    <Border Style="{StaticResource Badge}" Margin="0,12,0,0" Padding="10,6" Background="{DynamicResource Tone.Good.Background}"
                            Visibility="{Binding ReportStatus, Converter={StaticResource Visible}}">
                        <TextBlock Text="{Binding ReportStatus}" TextWrapping="Wrap" Foreground="{DynamicResource Tone.Good.Foreground}" />
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
