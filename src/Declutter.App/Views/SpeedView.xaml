<UserControl x:Class="Declutter.App.Views.SpeedView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Declutter.App.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="36,32,36,24">
            <DockPanel>
                <Button DockPanel.Dock="Right" Command="{Binding RefreshCommand}" VerticalAlignment="Top">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72C;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0" />
                        <TextBlock Text="Check again" />
                    </StackPanel>
                </Button>
                <StackPanel>
                    <TextBlock Text="Speed" Style="{StaticResource PageTitle}" />
                    <TextBlock Style="{StaticResource PageSubtitle}"
                               Text="How quickly Windows starts, what slows it down, the background services apps leave running, and whether new hardware would help." />
                </StackPanel>
            </DockPanel>
            <ProgressBar IsIndeterminate="{Binding IsBusy}" Margin="0,16,0,0" Visibility="{Binding IsBusy, Converter={StaticResource Visible}}" />
            <TextBlock Text="{Binding Status}" Style="{StaticResource Caption}" Margin="0,6,0,0" Visibility="{Binding Status, Converter={StaticResource Visible}}" />

            <!-- Start-up time -->
            <TextBlock Text="Start-up time" Style="{StaticResource SectionTitle}" Margin="0,24,0,10" />
            <Border Style="{StaticResource Card}" Padding="20,16">
                <StackPanel>
                    <TextBlock Text="Start-up timings come from a Windows log that only administrators can read. Restart Declutter as administrator to see them."
                               Style="{StaticResource Body}" Visibility="{Binding BootNeedsAdmin, Converter={StaticResource Visible}}" />
                    <Grid Visibility="{Binding BootNeedsAdmin, Converter={StaticResource Collapsed}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="220" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding BootHeadline}" FontFamily="{DynamicResource Font.Display}" FontSize="22" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding BootVerdict}" Style="{StaticResource Body}" Margin="0,2,0,0" />
                            <TextBlock Text="{Binding BootDetail}" Style="{StaticResource Caption}" TextWrapping="Wrap" TextTrimming="None" Margin="0,6,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="16,0,0,0" Visibility="{Binding HasBootData, Converter={StaticResource Visible}}">
                            <c:Sparkline Values="{Binding BootTrend}" Stroke="{DynamicResource Brush.Accent}" Height="54"
                                         AutomationProperties.Name="Start-up time over recent restarts" />
                            <TextBlock Text="Recent restarts (seconds)" Style="{StaticResource Caption}" HorizontalAlignment="Right" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Margin="0,16,0,0" Visibility="{Binding HasCulprits, Converter={StaticResource Visible}}">
                        <TextBlock Text="What Windows says slowed it down" Style="{StaticResource ItemTitle}" />
                        <ItemsControl ItemsSource="{Binding Culprits}" Margin="0,6,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock TextTrimming="CharacterEllipsis">
                                            <Run Text="{Binding Name, Mode=OneWay}" /><Run Text="  ·  " Foreground="{DynamicResource Brush.TextTertiary}" /><Run Text="{Binding Kind, Mode=OneWay}" Foreground="{DynamicResource Brush.TextSecondary}" />
                                        </TextBlock>
                                        <TextBlock Grid.Column="1" Margin="12,0,0,0" Foreground="{DynamicResource Brush.TextSecondary}">
                                            <Run Text="+" /><Run Text="{Binding AverageSeconds, Mode=OneWay, StringFormat=0.0}" /><Run Text=" s, " /><Run Text="{Binding Times, Mode=OneWay}" /><Run Text=" times" />
                                        </TextBlock>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" TextTrimming="None" Margin="0,8,0,0"
                                   Text="Apps here can usually be turned off on the Startup page. Drivers and Windows parts are best left alone." />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Hardware -->
            <TextBlock Text="Would new hardware help?" Style="{StaticResource SectionTitle}" Margin="0,24,0,10" Visibility="{Binding HasRun, Converter={StaticResource Visible}}" />
            <Border Style="{StaticResource Card}" Padding="20,12" Visibility="{Binding HasRun, Converter={StaticResource Visible}}">
                <ItemsControl ItemsSource="{Binding Hardware}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="0,6">
                                <TextBlock Text="{Binding Glyph}" Style="{StaticResource Icon}" FontSize="13" VerticalAlignment="Top" Margin="0,2,10,0"
                                           Foreground="{Binding Tone, Converter={StaticResource ToneForeground}}" />
                                <TextBlock Text="{Binding Text}" Style="{StaticResource Body}" />
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <!-- Services -->
            <DockPanel Margin="0,24,0,10" Visibility="{Binding HasRun, Converter={StaticResource Visible}}">
                <Button DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Command="{Binding ManualAllCommand}" VerticalAlignment="Center">
                    <TextBlock>
                        <Run Text="Set all suggested to Manual (" /><Run Text="{Binding SuggestedCount, Mode=OneWay}" /><Run Text=")" />
                    </TextBlock>
                </Button>
                <StackPanel Margin="0,0,16,0">
                    <TextBlock Text="Background services from your apps" Style="{StaticResource SectionTitle}" />
                    <TextBlock Style="{StaticResource Body}" Margin="0,4,0,0"
                               Text="These start with Windows and run all day. Updaters and usage-reporting helpers work fine on Manual: they start when their app needs them. Windows' own services aren't listed." />
                </StackPanel>
            </DockPanel>
            <TextBlock Text="No app services start automatically. Nice and lean." Style="{StaticResource Body}">
                <TextBlock.Visibility>
                    <MultiBinding Converter="{StaticResource AllTrue}">
                        <Binding Path="HasRun" />
                        <Binding Path="ServiceRows.Count" Converter="{StaticResource IsZero}" />
                    </MultiBinding>
                </TextBlock.Visibility>
            </TextBlock>
            <ItemsControl ItemsSource="{Binding ServiceRows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,6" Padding="16,12">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center" Margin="12,0,0,0">
                                    <Button Content="{Binding ButtonText}" Command="{Binding ToggleCommand}" MinWidth="120"
                                            AutomationProperties.Name="{Binding Name, StringFormat=Change how {0} starts}" />
                                </StackPanel>
                                <StackPanel>
                                    <DockPanel>
                                        <Border DockPanel.Dock="Right" Style="{StaticResource Badge}" Margin="10,0,0,0"
                                                Background="{Binding AdviceTone, Converter={StaticResource ToneBackground}}">
                                            <TextBlock Text="{Binding AdviceLabel}" FontSize="12" FontWeight="SemiBold" Foreground="{Binding AdviceTone, Converter={StaticResource ToneForeground}}" />
                                        </Border>
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource ItemTitle}" />
                                    </DockPanel>
                                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Caption}" />
                                    <TextBlock Text="{Binding AdviceReason}" Style="{StaticResource Body}" Margin="0,4,0,0" />
                                    <TextBlock Text="{Binding StateText}" Style="{StaticResource Caption}" Margin="0,4,0,0" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
