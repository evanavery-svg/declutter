<UserControl x:Class="Declutter.App.Views.AppsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <DataTemplate x:Key="PillTemplate">
            <RadioButton Style="{StaticResource Pill}" Content="{Binding Label}" IsChecked="{Binding IsSelected}"
                         GroupName="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
        </DataTemplate>
        <ItemsPanelTemplate x:Key="HorizontalPanel">
            <StackPanel Orientation="Horizontal" />
        </ItemsPanelTemplate>
    </UserControl.Resources>

    <Grid Margin="36,32,36,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel>
            <Button DockPanel.Dock="Right" Command="{Binding RefreshCommand}" VerticalAlignment="Top">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE72C;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0" />
                    <TextBlock Text="Refresh" />
                </StackPanel>
            </Button>
            <StackPanel>
                <TextBlock Text="Apps" Style="{StaticResource PageTitle}" />
                <TextBlock Style="{StaticResource PageSubtitle}"
                           Text="Uninstall apps you don't use. Preinstalled extras are marked, and things Windows needs are protected from batch removal." />
            </StackPanel>
        </DockPanel>

        <StackPanel Grid.Row="1" Margin="0,20,0,12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Sort by" Style="{StaticResource Body}" VerticalAlignment="Center" Margin="16,0,10,0" />
                    <ItemsControl ItemsSource="{Binding Sort.Options}" Tag="{Binding Sort.Group}" ItemTemplate="{StaticResource PillTemplate}" ItemsPanel="{StaticResource HorizontalPanel}" />
                </StackPanel>
                <TextBox DockPanel.Dock="Left" Style="{StaticResource SearchBox}" Width="240" Tag="Search apps"
                         Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,16,0" VerticalAlignment="Center" />
                <ItemsControl ItemsSource="{Binding Filter.Options}" Tag="{Binding Filter.Group}" ItemTemplate="{StaticResource PillTemplate}"
                              ItemsPanel="{StaticResource HorizontalPanel}" VerticalAlignment="Center" />
            </DockPanel>
            <TextBlock Text="{Binding Summary}" Style="{StaticResource Body}" Margin="0,12,0,0" />
            <ProgressBar IsIndeterminate="{Binding IsBusy}" Margin="0,10,0,0" Visibility="{Binding IsBusy, Converter={StaticResource Visible}}" />
            <TextBlock Text="{Binding Status}" Style="{StaticResource Caption}" Margin="0,6,0,0" Visibility="{Binding Status, Converter={StaticResource Visible}}" />
        </StackPanel>

        <ListBox Grid.Row="2" Style="{StaticResource CardList}" ItemsSource="{Binding View}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource Card}" Padding="14,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <CheckBox IsChecked="{Binding IsSelected}" IsEnabled="{Binding CanSelect}" Margin="0,0,14,0" ToolTip="Select for uninstalling" />
                            <StackPanel Grid.Column="1">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource ItemTitle}" MaxWidth="460" />
                                    <Border Style="{StaticResource Badge}" Margin="10,0,0,0" Background="{Binding AdviceTone, Converter={StaticResource ToneBackground}}"
                                            Visibility="{Binding HasAdvice, Converter={StaticResource Visible}}">
                                        <TextBlock Text="{Binding AdviceLabel}" FontSize="12" FontWeight="SemiBold" Foreground="{Binding AdviceTone, Converter={StaticResource ToneForeground}}" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                                <TextBlock Text="{Binding AdviceReason}" Style="{StaticResource Body}" Margin="0,4,0,0" Visibility="{Binding AdviceReason, Converter={StaticResource Visible}}" />
                                <TextBlock Text="{Binding AdminNote}" FontSize="12" Foreground="{DynamicResource Tone.Caution.Foreground}" Margin="0,4,0,0"
                                           Visibility="{Binding AdminNote, Converter={StaticResource Visible}}" />
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="{Binding DateText}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="16,0" />
                            <TextBlock Grid.Column="3" Text="{Binding SizeText}" Style="{StaticResource Figure}" FontSize="14" />
                            <Button Grid.Column="4" Content="Uninstall" Command="{Binding UninstallCommand}" Margin="16,0,0,0" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Border Grid.Row="3" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0" Padding="0,14,0,0" Margin="0,8,0,0">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource DangerButton}" Content="{Binding UninstallButtonText}" Command="{Binding UninstallSelectedCommand}" MinWidth="180" />
                <TextBlock Style="{StaticResource Caption}" VerticalAlignment="Center" TextWrapping="Wrap" TextTrimming="None" Margin="0,0,16,0"
                           Text="Programs use their own uninstaller, so you may see their windows. Store apps are removed directly." />
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
