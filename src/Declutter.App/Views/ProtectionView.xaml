<UserControl x:Class="Declutter.App.Views.ProtectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="36,32,36,24">
            <DockPanel>
                <Button DockPanel.Dock="Right" Command="{Binding RefreshCommand}" VerticalAlignment="Top">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72C;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0" />
                        <TextBlock Text="Check again" />
                    </StackPanel>
                </Button>
                <StackPanel>
                    <TextBlock Text="Protection" Style="{StaticResource PageTitle}" />
                    <TextBlock Style="{StaticResource PageSubtitle}"
                               Text="Would your files survive a broken or stolen laptop, and is Windows up to date? Plus every browser extension and what it can see. Nothing is changed." />
                </StackPanel>
            </DockPanel>

            <ProgressBar IsIndeterminate="{Binding IsBusy}" Margin="0,16,0,0" Visibility="{Binding IsBusy, Converter={StaticResource Visible}}" />
            <TextBlock Text="{Binding Status}" Style="{StaticResource Caption}" Margin="0,6,0,0" Visibility="{Binding Status, Converter={StaticResource Visible}}" />

            <Border Style="{StaticResource Card}" Margin="0,16,0,0" BorderThickness="0" Background="{Binding SummaryTone, Converter={StaticResource ToneBackground}}"
                    Visibility="{Binding HasRun, Converter={StaticResource Visible}}">
                <TextBlock Text="{Binding Summary}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{Binding SummaryTone, Converter={StaticResource ToneForeground}}" />
            </Border>

            <ItemsControl ItemsSource="{Binding Areas}" Margin="0,16,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,10" Padding="20,16">
                            <StackPanel>
                                <DockPanel>
                                    <Border DockPanel.Dock="Right" Style="{StaticResource Badge}" Margin="12,0,0,0" VerticalAlignment="Top"
                                            Background="{Binding GradeTone, Converter={StaticResource ToneBackground}}">
                                        <TextBlock Text="{Binding GradeLabel}" FontSize="12" FontWeight="SemiBold" Foreground="{Binding GradeTone, Converter={StaticResource ToneForeground}}" />
                                    </Border>
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource ItemTitle}" />
                                </DockPanel>
                                <TextBlock Text="{Binding Summary}" FontSize="15" FontWeight="SemiBold" Margin="0,8,0,0" TextWrapping="Wrap" />
                                <ItemsControl ItemsSource="{Binding Notes}" Margin="0,8,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel Margin="0,4">
                                                <TextBlock Text="{Binding Glyph}" Style="{StaticResource Icon}" FontSize="13" VerticalAlignment="Top" Margin="0,2,10,0"
                                                           Foreground="{Binding Tone, Converter={StaticResource ToneForeground}}" />
                                                <TextBlock Text="{Binding Text}" Style="{StaticResource Body}" />
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button Content="{Binding ActionLabel}" Command="{Binding ActionCommand}" HorizontalAlignment="Left" Margin="0,10,0,0"
                                        Visibility="{Binding ActionLabel, Converter={StaticResource Visible}}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Browser extensions -->
            <StackPanel Margin="0,14,0,10" Visibility="{Binding HasRun, Converter={StaticResource Visible}}">
                <TextBlock Text="Browser extensions" Style="{StaticResource SectionTitle}" />
                <TextBlock Style="{StaticResource Body}" Margin="0,4,0,0"
                           Text="Extensions can read the pages you visit, so a shady one sees your email and banking. Remove any you do not recognise from the browser's own extensions page." />
                <TextBlock Text="{Binding ExtensionSummary}" Style="{StaticResource Caption}" Margin="0,4,0,0" />
            </StackPanel>
            <ItemsControl ItemsSource="{Binding Extensions}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,6" Padding="16,12">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                    <Button Content="Look it up" Command="{Binding LookUpCommand}" Style="{StaticResource SubtleButton}" Margin="0,0,6,0"
                                            AutomationProperties.Name="{Binding Name, StringFormat=Look up {0}}" />
                                    <Button Content="{Binding OpenPageText}" Command="{Binding OpenPageCommand}" />
                                </StackPanel>
                                <StackPanel>
                                    <DockPanel>
                                        <Border DockPanel.Dock="Right" Style="{StaticResource Badge}" Margin="10,0,0,0"
                                                Background="{Binding RiskTone, Converter={StaticResource ToneBackground}}">
                                            <TextBlock Text="{Binding RiskLabel}" FontSize="12" FontWeight="SemiBold" Foreground="{Binding RiskTone, Converter={StaticResource ToneForeground}}" />
                                        </Border>
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource ItemTitle}" TextTrimming="CharacterEllipsis" />
                                    </DockPanel>
                                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Caption}" />
                                    <TextBlock Text="{Binding Why}" Style="{StaticResource Body}" Margin="0,4,0,0" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
