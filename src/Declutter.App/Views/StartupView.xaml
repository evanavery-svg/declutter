<UserControl x:Class="Declutter.App.Views.StartupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="36,32,36,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                <Button Content="Open Task Manager" Command="{Binding OpenTaskManagerCommand}" Margin="0,0,8,0" />
                <Button Command="{Binding RefreshCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72C;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0" />
                        <TextBlock Text="Refresh" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <StackPanel>
                <TextBlock Text="Startup apps" Style="{StaticResource PageTitle}" />
                <TextBlock Style="{StaticResource PageSubtitle}"
                           Text="Apps that open by themselves when you sign in slow down boot and use memory all day. Turning one off doesn't uninstall it, and you can turn it back on here or in Task Manager." />
            </StackPanel>
        </DockPanel>

        <StackPanel Grid.Row="1" Margin="0,20,0,12">
            <Border Style="{StaticResource Card}" Margin="0,0,0,12" BorderThickness="0" Background="{DynamicResource Tone.Caution.Background}"
                    Visibility="{Binding HasLockedItems, Converter={StaticResource Visible}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Restart as administrator" VerticalAlignment="Center"
                            Command="{Binding DataContext.RestartAsAdminCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                    <TextBlock TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{DynamicResource Tone.Caution.Foreground}" Margin="0,0,12,0"
                               Text="Some apps start for every user on this PC. Changing those needs administrator rights." />
                </DockPanel>
            </Border>

            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Command="{Binding DisableSuggestedCommand}"
                        ToolTip="Turns off every app marked 'Safe to turn off'. You'll be asked to confirm.">
                    <TextBlock>
                        <Run Text="Turn off all suggested (" /><Run Text="{Binding SuggestedCount, Mode=OneWay}" /><Run Text=")" />
                    </TextBlock>
                </Button>
                <ItemsControl ItemsSource="{Binding Filter.Options}" VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <RadioButton Style="{StaticResource Pill}" Content="{Binding Label}" IsChecked="{Binding IsSelected}"
                                         GroupName="{Binding DataContext.Filter.Group, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>

            <TextBlock Text="{Binding Summary}" Style="{StaticResource Body}" Margin="0,12,0,0" />
            <ProgressBar IsIndeterminate="{Binding IsBusy}" Margin="0,10,0,0" Visibility="{Binding IsBusy, Converter={StaticResource Visible}}" />
            <TextBlock Text="{Binding Status}" Style="{StaticResource Caption}" Margin="0,6,0,0" Visibility="{Binding Status, Converter={StaticResource Visible}}" />
        </StackPanel>

        <ListBox Grid.Row="2" Style="{StaticResource CardList}" ItemsSource="{Binding View}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource ItemTitle}" MaxWidth="420" />
                                    <Border Style="{StaticResource Badge}" Margin="10,0,0,0" Background="{Binding AdviceTone, Converter={StaticResource ToneBackground}}">
                                        <TextBlock Text="{Binding AdviceLabel}" FontSize="12" FontWeight="SemiBold" Foreground="{Binding AdviceTone, Converter={StaticResource ToneForeground}}" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Caption}" Margin="0,2,0,0" Visibility="{Binding Subtitle, Converter={StaticResource Visible}}" />
                                <TextBlock Text="{Binding AdviceReason}" Style="{StaticResource Body}" Margin="0,6,0,0" />
                                <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0" ToolTip="{Binding Command}">
                                    <Run Text="{Binding SourceText, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding Command, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock Text="{Binding LockText}" FontSize="12" Foreground="{DynamicResource Tone.Caution.Foreground}" Margin="0,4,0,0"
                                           Visibility="{Binding LockText, Converter={StaticResource Visible}}" />
                            </StackPanel>
                            <Button Grid.Column="1" Style="{StaticResource SubtleButton}" Command="{Binding ShowFileCommand}" VerticalAlignment="Center" Margin="12,0"
                                    ToolTip="Show the program in File Explorer">
                                <TextBlock Text="&#xE838;" Style="{StaticResource Icon}" FontSize="14" />
                            </Button>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding StateText}" Width="28" VerticalAlignment="Center" Foreground="{DynamicResource Brush.TextSecondary}" />
                                <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding IsOn}" IsEnabled="{Binding CanToggle}" Margin="8,0,0,0"
                                          ToolTip="Start this app when you sign in" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
