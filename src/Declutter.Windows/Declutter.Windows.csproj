<Project Sdk="Microsoft.NET.Sdk">
  <!-- Windows-only implementations: registry, shell, Task Scheduler, Store packages. -->
  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <RootNamespace>Declutter.Windows</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- WMI: Defender status, Security Center, firewall, processes. -->
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Declutter.Core\Declutter.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Declutter.Windows.Tests" />
  </ItemGroup>
</Project>
